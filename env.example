BOT_TOKEN=123456:ABC...          # от @BotFather
CHANNEL_ID=@your_channel         # или -100xxxxxxxxxx
ALLOWED_USER_IDS=123456789       # твой Telegram ID (через запятую, если несколько)

# Необязательно. Если пусто — берётся единственная сохранённая сессия Instaloader
# или логин спросят в терминале. Пароль нигде не хранится, его всегда вводят вручную.
IG_USERNAME=

IG_LIKE=true                     # false — без лайка; тогда instagrapi вообще не используется
REACTION_EMOJI=😁                # реакция бота в канале (должна быть разрешена в канале)
PENDING_TIMEOUT=60               # сколько секунд ждать текст после ссылки без текста (потом пост уйдёт без подписи)
DOWNLOAD_TIMEOUT=180             # потолок на скачивание поста из Instagram, секунды
